# ═══════════════════════════════════════════════════════════════════════════
#  MOEX Signal Bot — configuration template
#  Copy to .env and fill in your own values:   cp .env.example .env
#  .env is git-ignored and must NEVER be committed.
#  Шаблон конфигурации. Скопируй в .env и впиши свои значения.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Anthropic (AI news analysis) — optional ────────────────────────────────
# Get a key: https://console.anthropic.com/settings/keys
# Without it the bot still works, only the AI news module is skipped.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# ─── Telegram notifications — optional ──────────────────────────────────────
# Token:   message @BotFather → /newbot
# chat_id: message /start to your bot, then open
#          https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── T-Investments (T-Bank) — optional, needed for sandbox paper trading ────
# Create a token: https://www.tbank.ru/invest/settings/api/  (type: full access)
# The same token serves both market data and the sandbox.
TINVEST_TOKEN=
# Filled in automatically after:  python3 tinvest_data.py --create-sandbox
TINVEST_SANDBOX_ACCOUNT_ID=

# ─── Market settings ────────────────────────────────────────────────────────
# CBR key rate, update manually after each rate decision
CBR_KEY_RATE=16.5
# Minimum daily turnover (RUB) — filters out illiquid days
MIN_VOLUME_RUB=50000000
# Minimum interval before re-sending the same signal to Telegram (hours)
TG_REPEAT_HOURS=6

# ─── Position sizing (sandbox) ──────────────────────────────────────────────
# SANDBOX_MAX_POS_PCT    — max size of a SINGLE position (% of equity)
# SANDBOX_MAX_TICKER_PCT — max concentration in one ticker (all positions)
# SANDBOX_MAX_TOTAL_PCT  — max total deployed capital
SANDBOX_MAX_POS_PCT=10
SANDBOX_MAX_TICKER_PCT=15
SANDBOX_MAX_TOTAL_PCT=60

# ─── Safety switches ────────────────────────────────────────────────────────
# Keep this false. Real-money trading is a stub and is NOT recommended:
# the strategy has no proven edge after costs (see README).
ENABLE_REAL_TRADING=false
# Loosens throttle gates ONLY, to gather forward-test statistics faster.
# Sandbox use only. Hard guards (MAX_DAILY_LOSS_PCT, MAX_STOP_PCT) stay active.
FORWARD_TEST_MODE=0

# ─── Risk limits ────────────────────────────────────────────────────────────
RISK_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_STOP_PCT=5.0
MAX_DAILY_STOP_LOSSES=3
ROUNDTRIP_COST_PCT=0.1

# Every other tuning knob (STOP_ATR_MULT, TAKE1_ATR_MULT, WEEKLY_*, NEWS_*,
# INDEX_REBOUND_*, RECENT_PERF_*, ...) has a sane default in the code and only
# needs to be set here to override it.
